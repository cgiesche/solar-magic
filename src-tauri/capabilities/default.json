{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "the editor window: open/save dialogs, reading and writing the files chosen in them",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-set-theme",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file"
  ]
}
