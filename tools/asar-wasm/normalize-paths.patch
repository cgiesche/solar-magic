+	// smwe: resolve the path like the OS does - repeated slashes, "." and any
+	// number of ".." in a row (the code below handles only one ".." per folder),
+	// so in-memory files are found by the same paths as real files.
+	{
+		std::vector<std::string> parts;
+		std::string all(normalized.data(), normalized.length()), part;
+		bool absolute = !all.empty() && all[0] == '/';
+		bool trailing = !all.empty() && all[all.size() - 1] == '/';
+		for (size_t i = 0; i <= all.size(); ++i)
+		{
+			if (i < all.size() && all[i] != '/') { part += all[i]; continue; }
+			if (part == "..")
+			{
+				if (!parts.empty() && parts.back() != "..") parts.pop_back();
+				else if (!absolute) parts.push_back(part);
+			}
+			else if (!part.empty() && part != ".") parts.push_back(part);
+			part.clear();
+		}
+		std::string out = absolute ? "/" : "";
+		for (size_t i = 0; i < parts.size(); ++i) { if (i) out += '/'; out += parts[i]; }
+		if (trailing && !parts.empty()) out += '/';
+		normalized = out.c_str();
+	}
+
